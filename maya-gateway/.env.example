# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# Loaded at startup by godotenv.Load(), which reads the process working directory,
# so the binary must be run from inside maya-gateway/.

# --- MAYA ---
# Sandbox: https://pg-sandbox.paymaya.com | Production: https://pg.paymaya.com
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
# Public API key (pk-...). Used for Basic auth on POST /checkout/v1/checkouts.
MAYA_PUBLIC_KEY=
# Secret API key (sk-...). Used for Basic auth on GET /checkout/v1/checkouts/:id.
MAYA_SECRET_KEY=

# --- POSTGRES ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=
DB_NAME=maya_gateway